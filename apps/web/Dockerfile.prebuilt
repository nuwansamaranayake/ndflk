# Runtime image from a build made on the host (used where the Docker build has no registry access).
# Run `npm run build` in apps/web first.
FROM node:22-bookworm-slim AS run
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 CORPUS_DIR=/corpus UPLOAD_DIR=/data/uploads
RUN groupadd -r ndf && useradd -r -g ndf ndf && mkdir -p /data/uploads /app/.next/cache && chown -R ndf:ndf /data /app
COPY apps/web/.next/standalone ./
COPY apps/web/.next/static ./.next/static
COPY apps/web/public ./public
COPY apps/web/scripts ./scripts
COPY apps/web/src/content ./src/content
COPY apps/web/node_modules/pg ./node_modules/pg
COPY apps/web/node_modules/pg-pool ./node_modules/pg-pool
COPY apps/web/node_modules/pg-protocol ./node_modules/pg-protocol
COPY apps/web/node_modules/pg-types ./node_modules/pg-types
COPY apps/web/node_modules/pg-connection-string ./node_modules/pg-connection-string
COPY apps/web/node_modules/pgpass ./node_modules/pgpass
COPY apps/web/node_modules/postgres-array ./node_modules/postgres-array
COPY apps/web/node_modules/postgres-bytea ./node_modules/postgres-bytea
COPY apps/web/node_modules/postgres-date ./node_modules/postgres-date
COPY apps/web/node_modules/postgres-interval ./node_modules/postgres-interval
COPY apps/web/node_modules/pg-int8 ./node_modules/pg-int8
COPY apps/web/node_modules/pg-cloudflare ./node_modules/pg-cloudflare
COPY apps/web/node_modules/split2 ./node_modules/split2
COPY apps/web/node_modules/xtend ./node_modules/xtend
COPY corpus /corpus
COPY db/migrations /app/db/migrations
COPY scripts/smoke.mjs /app/scripts/smoke.mjs
ENV MIGRATIONS_DIR=/app/db/migrations
RUN mkdir -p /app/.next/cache && chown -R ndf:ndf /app/.next/cache
USER ndf
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
